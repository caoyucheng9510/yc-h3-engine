# 将本模板复制为 .env，再按需要填写。全局配置固定在 ~/.yc-h3-engine/.env。
# 优先级为 --env-file、当前目录 .env、全局 .env、进程环境变量。空值会继续查找下一层。

# RunningHub。先在网页复制所需工作流并成功运行一次，再填入自己的副本 ID。
RUNNINGHUB_API_KEY=
RUNNINGHUB_WORKFLOW_ID=
# 可选，分别为文戏和武打指定工作流副本 ID。
RUNNINGHUB_WORKFLOW_ID_HYBRID=
RUNNINGHUB_WORKFLOW_ID_COMBAT=

# 晨羽按次工作流与独占 GPU 共用同一个 API Key 和钱包。
CHENYU_API_KEY=

# 可选，状态、断点和台账目录。默认 ~/.yc-h3-engine，也可通过 --data-dir 指定。
YC_H3_DATA_DIR=

# 可选，填写实际使用的人民币估算费率，每点或每 CU 的人民币金额。
RUNNINGHUB_CNY_PER_POINT=
COLAB_CNY_PER_CU=

# 可选，本机 Colab 守护进程，仅接受回环地址。
# YC_H3_HOST=127.0.0.1
# YC_H3_PORT=7798

# 可选，分别限制本地并行提交与晨羽账户内进行中的作业数。
# YC_H3_RUNNINGHUB_MAX_CONCURRENCY=1
# YC_H3_CHENYU_MAX_CONCURRENCY=1
# YC_H3_CHENYU_MAX_INFLIGHT=1

# 可选，为自定义 HTTPS API 补充受信的主机名。多个主机用英文逗号分隔。
YC_H3_TRUSTED_API_HOSTS=
